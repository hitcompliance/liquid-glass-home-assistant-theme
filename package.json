{
  "name": "liquid-glass-home-assistant-theme",
  "private": true,
  "type": "module",
  "scripts": {
    "build:glass": "node scripts/build-glass.mjs",
    "test:theme": "ruby tests/check_theme.rb",
    "test:browser": "node tests/browser-smoke.mjs",
    "build:cards": "node scripts/build-cards.mjs",
    "build": "npm run build:cards",
    "test:package": "node tests/package-smoke.mjs",
    "test:installer": "python3 scripts/test-installer.py",
    "test:demo": "node tests/public-showcase-browser.mjs",
    "build:integration": "python3 scripts/build-integration.py",
    "test:integration": "python3 scripts/test-integration.py",
    "test:demo-entities": "python3 scripts/test-demo.py",
    "build:demo": "python3 scripts/build-public-demo.py",
    "test:theme-store": "python3 scripts/test-theme-store.py",
    "test:media-volume": "node tests/media-volume-browser.mjs"
  },
  "dependencies": {
    "@samasante/liquid-glass": "0.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lit": "3.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "^1.61.1"
  },
  "version": "3.5.2",
  "description": "Satin Liquid Glass theme, complete custom-card bundle and interactive design gallery for Home Assistant"
}
