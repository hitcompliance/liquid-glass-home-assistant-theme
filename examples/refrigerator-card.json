{
  "type": "vertical-stack",
  "cards": [
    {
      "type": "heading",
      "heading": "Kühlgeräte"
    },
    {
      "type": "custom:button-card",
      "entity": "switch.example_refrigerator",
      "show_name": false,
      "show_state": false,
      "triggers_update": [
        "switch.example_refrigerator",
        "switch.example_refrigerator_child_lock",
        "switch.example_refrigerator_led_enable",
        "sensor.example_refrigerator_power",
        "sensor.example_refrigerator_energy",
        "number.example_refrigerator_temperature",
        "number.example_freezer_temperature",
        "switch.example_refrigerator_express_mode",
        "binary_sensor.example_refrigerator_door"
      ],
      "styles": {
        "grid": [
          {
            "grid-template-areas": "\"device title values\" \"device status values\" \"graph graph graph\""
          },
          {
            "grid-template-columns": "112px minmax(0,1fr) minmax(86px,auto)"
          },
          {
            "grid-template-rows": "32px 32px minmax(0,1fr)"
          }
        ],
        "card": [
          {
            "padding": "6px 0 0 0"
          },
          {
            "overflow": "hidden"
          },
          {
            "border": "var(--dash6-material-9aa1c302)"
          },
          {
            "border-radius": "16px"
          },
          {
            "height": "116px"
          },
          {
            "min-height": "116px"
          },
          {
            "max-height": "116px"
          }
        ],
        "custom_fields": {
          "device": [
            {
              "align-self": "start"
            },
            {
              "padding-left": "8px"
            },
            {
              "background": "transparent"
            },
            {
              "position": "relative"
            },
            {
              "z-index": "2"
            },
            {
              "padding-top": "8px"
            }
          ],
          "title": [
            {
              "justify-self": "start"
            },
            {
              "font-size": "16px"
            },
            {
              "font-weight": "700"
            },
            {
              "padding-top": "4px"
            },
            {
              "white-space": "nowrap"
            },
            {
              "overflow": "hidden"
            },
            {
              "text-overflow": "ellipsis"
            },
            {
              "max-width": "100%"
            },
            {
              "background": "transparent"
            },
            {
              "position": "relative"
            },
            {
              "z-index": "2"
            }
          ],
          "status": [
            {
              "justify-self": "start"
            },
            {
              "font-size": "13px"
            },
            {
              "color": "var(--secondary-text-color)"
            },
            {
              "padding-top": "2px"
            },
            {
              "background": "transparent"
            },
            {
              "position": "relative"
            },
            {
              "z-index": "2"
            }
          ],
          "values": [
            {
              "position": "absolute"
            },
            {
              "top": "0"
            },
            {
              "right": "0"
            },
            {
              "z-index": "2"
            },
            {
              "justify-self": "end"
            },
            {
              "align-self": "start"
            },
            {
              "text-align": "right"
            },
            {
              "padding-right": "52px"
            },
            {
              "padding-top": "4px"
            },
            {
              "line-height": "1.35"
            },
            {
              "background": "transparent"
            },
            {
              "overflow": "visible"
            }
          ],
          "graph": [
            {
              "width": "100%"
            },
            {
              "height": "80px"
            },
            {
              "align-self": "end"
            },
            {
              "margin-top": "0"
            },
            {
              "opacity": "0.6"
            },
            {
              "background": "transparent"
            },
            {
              "overflow": "hidden"
            }
          ],
          "door": [
            {
              "align-self": "center"
            },
            {
              "overflow": "hidden"
            }
          ],
          "controls": [
            {
              "align-self": "stretch"
            },
            {
              "overflow": "visible"
            }
          ],
          "graphs": [
            {
              "align-self": "end"
            },
            {
              "overflow": "hidden"
            },
            {
              "height": "92px"
            }
          ],
          "door_status": [
            {
              "position": "absolute",
              "top": "8px",
              "right": "8px",
              "z-index": "3",
              "pointer-events": "auto"
            }
          ]
        }
      },
      "custom_fields": {
        "device": {
          "card": {
            "type": "custom:dash6-glass-switch",
            "entity": "switch.example_refrigerator",
            "icon": "mdi:fridge",
            "switch_style": "liquid_glass",
            "child_lock_entity": "switch.example_refrigerator_child_lock"
          }
        },
        "title": "[[[\n  const name = entity.attributes.friendly_name || entity.entity_id;\n  const shortened = name\n    .replace(/\\b(?:Wohnzimmer(?: Neu)?|Küche|Schlafzimmer|Badezimmer|Büro|Flur|IKEA|Shelly|Meros|Refoss|Energy|Energie|kWh|Leistung|Power)\\b/ig, ' ')\n    .replace(/\\s+Led enable\\b/ig, ' ')\n    .replace(/\\s{2,}/g, ' ')\n    .replace(/^[\\s,;:/-]+|[\\s,;:/-]+$/g, '')\n    .trim();\n  return shortened || name;\n]]]",
        "status": "[[[ const base = entity.state === 'on' ? 'Eingeschaltet' : entity.state === 'off' ? 'Ausgeschaltet' : (entity.state || 'Unbekannt'); return base + (states['switch.example_refrigerator_express_mode']?.state === 'on' ? ' · Express-Kühlung aktiv!' : ''); ]]]",
        "values": "[[[\n const p=states['sensor.example_refrigerator_power'];\n const e=states['sensor.example_refrigerator_energy'];\n const fridgeTemp=states['number.example_refrigerator_temperature'];\n const freezerTemp=states['number.example_freezer_temperature'];\n const power=p && !['unknown','unavailable'].includes(p.state) ? Math.round(Number(p.state)).toLocaleString('de-DE') + ' ' + (p.attributes.unit_of_measurement || 'W') : '— W';\n const energy=e && !['unknown','unavailable'].includes(e.state) ? Math.round(Number(e.state)).toLocaleString('de-DE') + ' ' + (e.attributes.unit_of_measurement || 'kWh') : '— kWh';\n const temp = x => x && !['unknown','unavailable'].includes(x.state) ? Number(x.state).toLocaleString('de-DE') + '°' : '—';\n return '<div style=\"font-size:16px;font-weight:700;\">'+power+'</div><div style=\"font-size:13px;font-weight:400;\">'+energy+'</div><div style=\"margin-top:6px;font-size:12px;line-height:1.55;color:var(--secondary-text-color);\"><span style=\"display:block\"><ha-icon icon=\"mdi:fridge\" style=\"width:14px;height:14px;vertical-align:-2px;margin-right:4px\"></ha-icon>'+temp(fridgeTemp)+'</span><span style=\"display:block\"><ha-icon icon=\"mdi:snowflake\" style=\"width:14px;height:14px;vertical-align:-2px;margin-right:4px\"></ha-icon>'+temp(freezerTemp)+'</span></div>';\n]]]",
        "graph": {
          "card": {
            "type": "custom:mini-graph-card",
            "entities": [
              {
                "entity": "sensor.example_refrigerator_power"
              },
              {
                "entity": "input_number.example_refrigerator_openings_per_hour",
                "name": "Türöffnungen/h",
                "color": "#f59e0b",
                "y_axis": "secondary",
                "aggregate_func": "max",
                "show_line": false,
                "show_points": true,
                "show_fill": false,
                "show_state": false
              }
            ],
            "hours_to_show": 24,
            "line_width": 2,
            "animate": true,
            "show": {
              "name": false,
              "icon": false,
              "state": false,
              "legend": false,
              "extrema": false,
              "points": "hover",
              "labels": "hover"
            },
            "fill": "fade",
            "points_per_hour": 2,
            "group_by": "interval",
            "aggregate_func": "last",
            "smoothing": false,
            "hour24": true,
            "upper_bound": "~100",
            "lower_bound_secondary": 0,
            "upper_bound_secondary": "~5",
            "update_interval": 900,
            "dash6_css": {
              "style": "ha-card { container-type: inline-size !important; background: transparent !important; border: none !important; box-shadow: none !important; margin: 0 !important; padding: 0 !important; height: 80px !important; min-height: 80px !important; max-height: 80px !important; overflow: hidden !important; border-radius: 0 !important; } .graph, .graph__container, .graph__container__svg, svg { display: block !important; width: 100% !important; min-width: 0 !important; height: 80px !important; min-height: 80px !important; max-height: 80px !important; box-sizing: border-box !important; overflow: visible !important; } svg { transform: scaleX(max(1, calc(100cqw / 400px))) !important; transform-origin: center center !important; }",
              "class": ""
            }
          }
        },
        "door_status": "[[[ return states['binary_sensor.example_refrigerator_door']?.state === 'on' ? '<span title=\"Kühlschranktür offen\" aria-label=\"Kühlschranktür offen\" style=\"display:grid;place-items:center;width:32px;height:32px;border-radius:10px;background:var(--dash6-satin-control-background);border:var(--dash6-satin-control-border);box-shadow:var(--dash6-satin-control-shadow);color:var(--warning-color);\"><ha-icon icon=\"mdi:door-open\" style=\"width:22px;height:22px\"></ha-icon></span>' : ''; ]]]"
      },
      "show_icon": false,
      "tap_action": {
        "action": "more-info"
      },
      "hold_action": {
        "action": "more-info"
      }
    }
  ]
}
